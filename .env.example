# First start only. If empty, a random admin password appears once in startup logs.
CODAR_ADMIN_PASSWORD=
CODAR_PORT=8801
# Set true when accessing the panel through an HTTPS reverse proxy.
CODAR_SECURE_COOKIE=false
# Initial setting for Docker / remote administration; saved panel settings take precedence.
CODAR_ALLOW_REMOTE_MANAGEMENT=true
CODAR_MAX_CONCURRENT=128
