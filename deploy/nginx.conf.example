# Add as a separate site. Replace the server_name and configure HTTPS using
# your existing certificate tooling; keep other virtual hosts unchanged.
server {
    listen 80;
    server_name codar.example.com;
    client_max_body_size 8m;
    location / {
        proxy_pass http://127.0.0.1:8801;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 920s;
    }
}
